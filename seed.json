    {
      "id": "kuend-s",
      "phase": 2,
      "title": "Wohnung Sebastian kündigen",
      "owner": "S",
      "offset_days": -92,
      "critical": true,
      "type": "assist",
      "blocked_by": [
        "frist-s",
        "vertrag"
      ],
      "subtasks": [
        "Kündigungsschreiben erstellen (Vorlage von Claude)",
        "Per Einschreiben mit Rückschein senden",
        "Zugang beim Vermieter bestätigen lassen",
        "Kündigungsbestätigung ablegen"
      ],
      "advice": {
        "why": "Die Kündigung muss spätestens am 3. Werktag eines Monats zugehen, damit dieser Monat in die 3-Monats-Frist zählt. Ein Tag zu spät kostet einen ganzen Monat Doppelmiete.",
        "how": "1. Frist und Form im Altvertrag prüfen (Sonderregeln?)\n2. Schreiben erstellen: beide Mieter unterschreiben, falls beide im Vertrag\n3. Zustellung nachweisbar (Einschreiben Rückschein oder Bote mit Zeugen)\n4. Schriftliche Bestätigung des Vermieters einfordern\n5. Auszugs-Übergabetermin vorschlagen",
        "need": "Altvertrag, Vermieteradresse, Vorlage Kündigungsschreiben, Einschreiben-Beleg",
        "law": "§573c BGB: 3 Monate, Zugang bis zum 3. Werktag. Schriftform (§568 BGB) – E-Mail reicht nicht. [Beim Build gegen aktuelle Rechtslage prüfen]",
        "traps": "Laufender Konflikt mit der Vermieterin: Timing der Kündigung vor Absenden mit dem Staffelmiete-Thema abgleichen. Nicht per E-Mail oder mündlich ankündigen, was das Schreiben dann nicht deckt."
      }
    },
